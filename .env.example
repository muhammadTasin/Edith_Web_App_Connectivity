# Copy to .env and export the values in your shell (the server does NOT read .env files itself, e.g.:
#   set -a; source .env; set +a; npm start
# Placeholders only. Never commit real values. Everything below is read server-side.

# --- Server -------------------------------------------------------------------------------------
PORT=4000
# Comma-separated browser origins allowed to call the API cross-origin, or *. Empty = same-origin only
# (the bundled website needs nothing; the Android app is not a browser and needs nothing).
CORS_ORIGINS=
# If set, POST/DELETE on /api/v1/cattle/* require "Authorization: Bearer <token>". Minimum protection, not full auth.
API_WRITE_TOKEN=
# Where the cattle AOI/job JSON store lives (local-development store; NOT production durable)
CATTLE_STORE_PATH=
# true = create one clearly-flagged demo farm on first run
SEED_DEMO_DATA=false

# --- Weather providers --------------------------------------------------------------------------
# Open-Meteo works without a key for non-commercial use. A commercial key switches to customer-api.open-meteo.com.
OPEN_METEO_API_KEY=
# NASA POWER needs no credentials.

# --- Google Earth Engine (satellite NDVI / SMAP soil moisture / IMERG rain) ---------------------
# Requires: pip install earthengine-api, a Google Cloud project with the Earth Engine API enabled, and one of:
#   a service-account key file path below, or `earthengine authenticate` run as the server user.
EE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# python3 interpreter used for the worker (default python3) and an optional different worker script
EE_PYTHON=
EE_WORKER_PATH=
# IMERG Final lags by months; point this at a Late/Early collection id for recent rain totals
EE_IMERG_COLLECTION=NASA/GPM_L3/IMERG_V07
CATTLE_JOB_TIMEOUT_MS=180000

# --- Text generation (optional; any OpenAI-compatible /chat/completions endpoint) ---------------
# Gemma 3 4B can be served behind such an endpoint (vLLM, Ollama /v1, ...). Setting these does not make a model
# exist: you must run one. Unset = deterministic template narration is used.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000

# --- Text to speech (optional; separate from text generation) ------------------------------------
# POST {text, language, voice} -> audio/* bytes. Unset = clients use on-device speech and say so.
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=

# --- Demo accounts -------------------------------------------------------------------------------
EDEN_OFFICER_CODE=
