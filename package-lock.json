{
  "name": "project-eden",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "project-eden",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*",
        "services/*"
      ]
    },
    "node_modules/@project-eden/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@project-eden/narration-core": {
      "resolved": "packages/narration-core",
      "link": true
    },
    "node_modules/@project-eden/rotation-engine": {
      "resolved": "packages/rotation-engine",
      "link": true
    },
    "packages/contracts": {
      "name": "@project-eden/contracts",
      "version": "1.0.0",
      "license": "MIT"
    },
    "packages/narration-core": {
      "name": "@project-eden/narration-core",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@project-eden/contracts": "file:../contracts"
      }
    },
    "packages/rotation-engine": {
      "name": "@project-eden/rotation-engine",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@project-eden/contracts": "file:../contracts"
      }
    }
  }
}
